      VALUE "OriginalFilename", "MSpektra.exe"
      VALUE "ProductName", "MSpektra"
      VALUE "ProductVersion", "4.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
